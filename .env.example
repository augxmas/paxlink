DB_HOST=127.0.0.1
DB_PORT=3306
PORT=4500
APP_URL=http://localhost:4500
# 운영 예: paxlink.example.com (성당 사이트: {성당ID}.paxlink.example.com)
# 로컬에서 비워 두면 {성당ID}.localhost:4500 으로 테스트할 수 있습니다.
PARISH_BASE_DOMAIN=
DB_NAME=paxlink
DB_USER=paxlink
DB_PASSWORD=replace_with_your_password
DATABASE_URL=mysql://paxlink:replace_with_your_password@127.0.0.1:3306/paxlink

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_smtp_username
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Paxlink
SMTP_SECURE=true

SUPERVISOR_USERNAME=supervisor
SUPERVISOR_PASSWORD=replace_with_supervisor_password
SUPERVISOR_EMAIL=supervisor@example.com
SUPERVISOR_SESSION_SECRET=replace_with_at_least_32_random_characters
EMAIL_DELIVERY_MODE=mock
PERSONAL_DATA_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
